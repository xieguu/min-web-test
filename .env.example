# Copy to .env for local use, or /etc/min-web-test.env for the systemd service.
# Uncomment and replace ALL SMTP placeholders before restarting the app.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=sender@example.com
# SMTP_PASS=YOUR_SMTP_AUTHORIZATION_CODE
# SMTP_FROM=sender@example.com
# For port 587 with STARTTLS, use SMTP_PORT=587 and SMTP_SECURE=0.
# TLS is required by default; do not disable it for an external mail provider.
